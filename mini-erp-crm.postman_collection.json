{
  "info": {
    "name": "Mini ERP + CRM Operations Portal API",
    "description": "Complete REST API collection for Mini ERP & CRM assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@minierp.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "2. Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Customer CRM Module",
      "item": [
        {
          "name": "Get Customers (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&search=&status=ACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "" },
                { "key": "status", "value": "ACTIVE" }
              ]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Sharma\",\n  \"mobile\": \"+91 9811223344\",\n  \"email\": \"vikram@globaltraders.com\",\n  \"businessName\": \"Global Traders Inc\",\n  \"gstNumber\": \"07XYZPA1234F1Z9\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"12 Industrial Estate, Phase 2, Gurgaon\",\n  \"status\": \"LEAD\",\n  \"followUpDate\": \"2026-07-25\",\n  \"notes\": \"Interested in bulk hardware shipments\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Add Follow-up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Discussed Q4 order pricing schedule\",\n  \"followUpDate\": \"2026-08-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:customerId/follow-up",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":customerId", "follow-up"]
            }
          }
        }
      ]
    },
    {
      "name": "Product & Inventory Module",
      "item": [
        {
          "name": "Get Products Catalog",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10&lowStock=false",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Adjust Stock (IN / OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityChanged\": 25,\n  \"movementType\": \"IN\",\n  \"reason\": \"Supplier restock delivery #PO-4091\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/:productId/stock-adjustment",
              "host": ["{{baseUrl}}"],
              "path": ["products", ":productId", "stock-adjustment"]
            }
          }
        },
        {
          "name": "Get Stock Movement Audit Log",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/movements/log",
              "host": ["{{baseUrl}}"],
              "path": ["products", "movements", "log"]
            }
          }
        }
      ]
    },
    {
      "name": "Sales Challan Module",
      "item": [
        {
          "name": "Create Sales Challan (Draft or Confirmed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"<CUSTOMER_ID>\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    {\n      \"productId\": \"<PRODUCT_ID>\",\n      \"quantity\": 2,\n      \"unitPrice\": 129.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Download Sales Challan PDF Invoice",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:challanId/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":challanId", "pdf"]
            }
          }
        }
      ]
    }
  ]
}
